{
  "name": "guides",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat",
    "disable_nodejs_process_v2"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "observability": {
    "enabled": true
  },
  "$schema": "node_modules/wrangler/config-schema.json"
}